# ---- Flutterwave ----
# Get these from https://app.flutterwave.com  ->  Settings -> API Keys
# Use the TEST keys (FLWSECK_TEST-...) until you are ready to go live.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Settings -> Webhooks -> "Secret hash".
# You invent this string yourself, paste it into the Flutterwave dashboard,
# and put the same value here. It is how we prove a webhook really came from them.
FLW_SECRET_HASH=choose-a-long-random-string-here

# ---- Paypack ----
# Get these from https://payments.paypack.rw -> your business dashboard.
# Rwandan MTN/Airtel Mobile Money only (no cards) - offered alongside
# Flutterwave so customers can pick either at checkout.
PAYPACK_CLIENT_ID=your-paypack-client-id
PAYPACK_CLIENT_SECRET=your-paypack-client-secret
PAYPACK_BASE_URL=https://payments.paypack.rw/api
# "production" once you are live with real money. Sandbox/test value is
# literally "developement" (Paypack's own spelling) - verify against their
# current docs before relying on this.
PAYPACK_ENVIRONMENT=developement
# Optional shared secret appended to your Paypack webhook URL as ?token=...
# for a defense-in-depth check. Payment truth always comes from re-querying
# Paypack directly (see settle.ts), never from the webhook body alone.
PAYPACK_WEBHOOK_TOKEN=choose-a-long-random-string-here

# ---- Resend (transactional email: verification codes, password reset, receipts) ----
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Without a verified domain, Resend can only send FROM its shared test domain
# (onboarding@resend.dev) and only TO the email your Resend account signed up
# with. Verify your own domain in the Resend dashboard before going live.
EMAIL_FROM=Target Traders <onboarding@resend.dev>

# ---- Africa's Talking (SMS: phone verification codes, password reset) ----
# Get these at https://account.africastalking.com (sandbox app works for free testing)
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
# Optional - a registered short/alphanumeric sender id. Leave blank to use
# Africa's Talking's shared/sandbox sender.
AT_SENDER_ID=

# Signs customer login tokens (separate from ADMIN_JWT_SECRET below).
USER_JWT_SECRET=change-me-to-a-long-random-string

# ---- Anthropic (dashboard catalog assistant: search/add/edit products by chat) ----
# Get an API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- URLs ----
# Where your React app runs (used for CORS and for the post-payment redirect).
CLIENT_URL=http://localhost:5173
# Public URL of THIS server. In local dev use an ngrok/cloudflared tunnel so
# Flutterwave can reach your webhook. e.g. https://abc123.ngrok-free.app
SERVER_URL=http://localhost:4000

PORT=4000

# ---- Database ----
# Postgres holds the catalog (categories/subcategories/products) that the
# admin dashboard edits and checkout prices against. Run via `docker compose
# up -d` from the project root (uses the root .env for POSTGRES_* values).
DATABASE_URL=postgresql://target_traders:target_traders@localhost:5432/target_traders

# Signs the login tokens for /admin. Change this before deploying anywhere public.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Bootstraps the first row in the `admins` table (run `npm run db:seed-admin`
# after `db:migrate`). Only used by that script, not read at request time.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@targettraders.rw
ADMIN_PASSWORD=change-me-strong-password

# ---- Store settings ----
CURRENCY=RWF
STORE_NAME=Target Traders Ltd

# VAT rate applied on top of catalog prices. Set to 0 if your catalog
# prices are already VAT-inclusive. See README - this needs a decision.
VAT_RATE=0.18

# Delivery
DELIVERY_FEE=2000
FREE_SHIPPING_THRESHOLD=59000
